{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nagarjuna-traders",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nagarjuna-traders-d1",
      "database_id": "nagarjuna-traders-d1-prod"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "PAYMENT_COLLECTION_ENABLED": "false",
    "RESTRICTED_TEST_MODE": "false",
    "STORE_NAME": "NAGARJUNA TRADERS",
    "STORE_LOCATION": "Sivakasi / Counter Collection",
    "STORE_UPI_VPA": "nagarjunatraders@okhdfcbank",
    "STORE_PHONE": "+919876543210"
  },
  "env": {
    "test": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nagarjuna-traders-d1-test",
          "database_id": "nagarjuna-traders-d1-test"
        }
      ],
      "vars": {
        "ENVIRONMENT": "test",
        "PAYMENT_COLLECTION_ENABLED": "false",
        "RESTRICTED_TEST_MODE": "true",
        "STORE_NAME": "NAGARJUNA TRADERS (RESTRICTED TEST)",
        "STORE_LOCATION": "Sivakasi / Counter Collection (Restricted Test)",
        "STORE_UPI_VPA": "test-fixture@nagarjunatraders",
        "STORE_PHONE": "+919876543210"
      }
    }
  }
}
