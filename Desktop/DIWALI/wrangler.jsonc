{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nagarjuna-traders-test",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nagarjuna-traders-d1-test",
      "database_id": "aace32a4-8ec3-487e-b202-a98e898868bc"
    }
  ],
  "vars": {
    "ENVIRONMENT": "test",
    "PAYMENT_COLLECTION_ENABLED": "false",
    "RESTRICTED_TEST_MODE": "true",
    "STORE_NAME": "NAGARJUNA TRADERS (RESTRICTED TEST)",
    "STORE_LOCATION": "Sivakasi / Counter Collection (Restricted Test)",
    "STORE_UPI_VPA": "test-fixture@nagarjunatraders",
    "STORE_PHONE": "+919876543210"
  }
}
