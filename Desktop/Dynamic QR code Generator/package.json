{
  "name": "qroute-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "npm run build:client",
    "build:client": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "npm run d1:seed:local && playwright test",
    "d1:migrate:local": "wrangler d1 migrations apply qroute_local --local",
    "d1:migrate:prod": "wrangler d1 migrations apply qroute_production --remote --env production",
    "d1:seed:local": "wrangler d1 execute qroute_local --local --file=./seed-local.sql",
    "deploy:prod": "wrangler deploy --env production"
  },
  "dependencies": {
    "@babel/types": "^7.29.8",
    "caniuse-lite": "^1.0.30001814",
    "clsx": "^2.1.1",
    "hono": "^4.7.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@cloudflare/workers-types": "^4.20250224.0",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.13.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.20.0",
    "jsqr": "^1.4.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.0",
    "wrangler": "^3.111.0"
  }
}
