# ==============================================================================
# QRoute Environment Configuration Example (.env.example)
# ==============================================================================
# IMPORTANT:
# - NEVER commit real credentials or production secrets to source control.
# - Copy this file to .env.local for local overrides.
# - Production secrets must be configured via `wrangler secret put <NAME>` or GitHub Secrets.

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT VARIABLES (Bundled into Vite frontend build)
# ------------------------------------------------------------------------------
# Cloudflare Turnstile public site key (safe to expose client-side)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAx_PLACEHOLDER_KEY

# ------------------------------------------------------------------------------
# 2. SERVER & WORKER BINDINGS (Worker runtime only - NEVER exposed to client)
# ------------------------------------------------------------------------------
# Server secret for computing HMAC-SHA256 digests of card activation codes
# Set in production using: wrangler secret put ACTIVATION_SECRET
ACTIVATION_SECRET=change_this_to_a_secure_64_character_hex_secret_in_production

# Cloudflare Turnstile server validation secret key
# Set in production using: wrangler secret put TURNSTILE_SECRET_KEY
TURNSTILE_SECRET_KEY=0x4AAAAAAAx_PLACEHOLDER_SECRET

# ------------------------------------------------------------------------------
# 3. CI/CD & DEPLOYMENT SECRETS (GitHub Actions Secrets - Not in local files)
# ------------------------------------------------------------------------------
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
# GPG_PASSPHRASE=your_passphrase_for_database_backups_here
